{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lebnene",
  "scopeName": "source.lebnene",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#function-def" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lebnene",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lebnene",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lebnene",
          "match": "\\\\[ntr\"\\\\]"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.lebnene",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "comment": "if / elif / else / while / for / return",
          "name": "keyword.control.lebnene",
          "match": "\\b(iza|gherhek|talama|la|redele)\\b"
        },
        {
          "comment": "function definition",
          "name": "storage.type.function.lebnene",
          "match": "\\b3arref\\b"
        },
        {
          "comment": "true / false / null",
          "name": "constant.language.lebnene",
          "match": "\\b(sa7|ghalat|mashi)\\b"
        },
        {
          "comment": "and / or / not",
          "name": "keyword.operator.logical.lebnene",
          "match": "\\b(w|aw|mish)\\b"
        },
        {
          "comment": "built-in print",
          "name": "support.function.builtin.lebnene",
          "match": "\\bfarjine\\b"
        }
      ]
    },
    "function-def": {
      "comment": "name right after 3arref",
      "match": "\\b3arref\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.function.lebnene" }
      }
    },
    "function-call": {
      "comment": "identifier immediately followed by (",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.lebnene" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lebnene",
          "match": "(==|!=|>=|<=|\\+=|-=|\\*=|/=|[+\\-*/%<>=])"
        }
      ]
    }
  }
}
